rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 여행 일정표 (trip/index.html)
    // 링크(여행 ID)를 아는 사람은 로그인 없이 그 여행만 읽고 쓸 수 있어요.
    // 여행 목록 전체를 조회하는 것은 막혀 있어요 (list 권한 없음).
    match /trips/{tripId} {
      allow get: if tripId.size() >= 12;
      allow create, update: if tripId.size() >= 12
        && request.resource.data.keys().hasOnly(['title', 'start', 'days', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.days is int
        && request.resource.data.days >= 1 && request.resource.data.days <= 14;

      match /events/{eventId} {
        allow read, delete: if tripId.size() >= 12;
        allow create, update: if tripId.size() >= 12
          && request.resource.data.keys().hasOnly(['title', 'place', 'memo', 'cat', 'day', 'start', 'end', 'updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.place is string && request.resource.data.place.size() <= 120
          && request.resource.data.memo is string && request.resource.data.memo.size() <= 500;
      }
    }
  }
}
