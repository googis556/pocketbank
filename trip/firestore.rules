rules_version = '2';

// 여행 일정표 전용 Firebase 프로젝트의 Firestore 보안 규칙
// (pocketbank 프로젝트에는 넣지 마세요)
//
// - 링크(여행 ID)를 아는 사람은 로그인 없이 그 여행을 "볼" 수 있어요.
// - 로그인한 사람이 링크로 들어오면 자기 자신을 편집자로 추가할 수 있어요.
// - 편집자만 일정과 여행 정보를 고칠 수 있고, 여행 삭제는 만든 사람만 할 수 있어요.
// - 남의 여행 목록을 훑어보는 것은 막혀 있어요 (내가 참여한 여행만 목록으로 조회).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(data) { return signedIn() && request.auth.uid in data.memberIds; }
    function tripOf(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }

    function validInfo(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.start is string && d.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.days is int && d.days >= 1 && d.days <= 14;
    }

    function validEvent(d) {
      return d.keys().hasOnly(['title', 'place', 'memo', 'cat', 'day', 'start', 'end',
                               'createdBy', 'createdByName', 'updatedBy', 'updatedByName', 'updatedAt'])
        && d.title is string && d.title.size() <= 80
        && d.place is string && d.place.size() <= 120
        && d.memo is string && d.memo.size() <= 500
        && d.cat in ['move', 'see', 'eat', 'stay', 'shop', 'etc']
        && d.day is int && d.day >= 0 && d.day < 14
        && d.start is int && d.end is int && d.start >= 0 && d.end <= 1440 && d.start < d.end
        && d.createdByName is string && d.createdByName.size() <= 40
        && d.updatedByName is string && d.updatedByName.size() <= 40
        && d.updatedBy == request.auth.uid;
    }

    match /trips/{tripId} {
      allow get: if tripId.size() >= 12;
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // 새 여행: 만든 사람이 유일한 편집자
      allow create: if signedIn() && tripId.size() >= 12
        && request.resource.data.keys().hasOnly(['title', 'start', 'days', 'ownerId', 'members', 'memberIds', 'createdAt', 'updatedAt'])
        && validInfo(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validName(request.resource.data.members[request.auth.uid]);

      // 편집자: 여행 이름·날짜·일수 수정, 또는 자기 표시 이름 변경
      allow update: if isMember(resource.data) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'start', 'days', 'updatedAt'])
            && validInfo(request.resource.data))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && validName(request.resource.data.members[request.auth.uid]))
      );

      // 참여: 링크로 들어온 로그인 사용자가 자기 자신만 편집자로 추가
      allow update: if signedIn() && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'updatedAt'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && validName(request.resource.data.members[request.auth.uid]);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /events/{eventId} {
        allow read: if tripId.size() >= 12;
        allow create: if isMember(tripOf(tripId)) && validEvent(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(tripOf(tripId)) && validEvent(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(tripOf(tripId));
      }
    }
  }
}
